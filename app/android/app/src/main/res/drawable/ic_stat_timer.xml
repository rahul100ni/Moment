<?xml version="1.0" encoding="utf-8"?>
<!-- Monochrome status bar icon: two interlinked stopwatch rings (Moment logo) -->
<!-- Android requires single-color white/transparent for status bar icons -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- Left stopwatch ring -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M35,18 A22,22 0 1,0 35,62 A22,22 0 1,0 35,18 Z
                          M35,22 A18,18 0 1,1 35,58 A18,18 0 1,1 35,22 Z" />
    <!-- Left crown/button -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M30,16 L40,16 L40,19 L30,19 Z" />

    <!-- Right stopwatch ring -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M65,18 A22,22 0 1,0 65,62 A22,22 0 1,0 65,18 Z
                          M65,22 A18,18 0 1,1 65,58 A18,18 0 1,1 65,22 Z" />
    <!-- Right crown/button -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M60,16 L70,16 L70,19 L60,19 Z" />

    <!-- Overlap mask (dark cutout to show interlinking) -->
    <path
        android:fillColor="#00000000"
        android:pathData="M50,30 A10,15 0 0,1 50,50 A10,15 0 0,1 50,30 Z" />
</vector>
